<?xml version="1.0"?>
<Container version="2">
  <Name>Glovebox</Name>
  <Repository>ghcr.io/matthewjackson446/glovebox:latest</Repository>
  <Registry>https://github.com/matthewjackson446/glovebox/pkgs/container/glovebox</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/matthewjackson446/glovebox/issues</Support>
  <Project>https://github.com/matthewjackson446/glovebox</Project>
  <Overview>Glovebox keeps track of your vehicles: MOT, road tax, insurance, servicing, breakdown cover, warranty and finance, all colour-coded by when they're due. Store policy numbers and claims lines, and pull up a one-tap emergency card at the roadside. Multi-user, with per-vehicle sharing. Data is stored in a single SQLite database in your appdata folder.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/matthewjackson446/glovebox/main/unraid/glovebox.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/matthewjackson446/glovebox/main/static/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <Requires/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Port for the Glovebox web interface." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/glovebox" Mode="rw" Description="Database and uploaded documents. Back this up." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/glovebox</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/London" Mode="" Description="Timezone, used for working out what's due today and when reminders are sent." Type="Variable" Display="always" Required="false" Mask="false">Europe/London</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID to run as." Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID to run as." Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="SMTP server" Target="SMTP_HOST" Default="" Mode="" Description="Optional. Email settings can be entered here or in Glovebox under Settings, Server. If set here, they take priority and are locked in the app. e.g. smtp.gmail.com" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP port" Target="SMTP_PORT" Default="587" Mode="" Description="587 for STARTTLS, 465 for TLS." Type="Variable" Display="advanced" Required="false" Mask="false">587</Config>
  <Config Name="SMTP security" Target="SMTP_SECURITY" Default="starttls" Mode="" Description="starttls, tls or none." Type="Variable" Display="advanced" Required="false" Mask="false">starttls</Config>
  <Config Name="SMTP username" Target="SMTP_USER" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP password" Target="SMTP_PASS" Default="" Mode="" Description="For Gmail, an app password." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="SMTP from address" Target="SMTP_FROM" Default="" Mode="" Description="e.g. Glovebox &lt;glovebox@example.com&gt;" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="" Description="File permission mask for created files." Type="Variable" Display="advanced" Required="false" Mask="false">022</Config>
</Container>
