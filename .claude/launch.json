{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "glovebox-dev",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
			"port": 5173
		},
		{
			"name": "glovebox-dev-mockgov",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--", "--port", "5174", "--strictPort"],
			"port": 5174,
			"env": {
				"GLOVEBOX_DVLA_URL": "http://localhost:9921/dvla",
				"GLOVEBOX_DVSA_URL": "http://localhost:9921/dvsa",
				"GLOVEBOX_DISABLE_SCHEDULER": "true"
			}
		}
	]
}
